{
    "extends": "../../tsconfig.json",
    "compilerOptions": {
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "target": "ES2022",
        "outDir": "./dist",
        "rootDir": "./src",
        "noEmit": false,
        "declaration": false,
        "sourceMap": false,
        "incremental": false,
        "allowJs": false,
        "tsBuildInfoFile": "../../.iron-solver/run-iron-solver/tsconfig.tsbuildinfo",
        "types": ["node"]
    },
    "include": ["src/**/*.ts"]
}
