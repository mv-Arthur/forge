{
    "type": "object",
    "additionalProperties": false,
    "required": ["result", "summary", "checklist", "bugs", "screenshots"],
    "properties": {
        "result": {
            "type": "string",
            "enum": ["pass", "fail"]
        },
        "summary": {
            "type": "string"
        },
        "checklist": {
            "type": "array",
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["item", "passed"],
                "properties": {
                    "item": {
                        "type": "string"
                    },
                    "passed": {
                        "type": "boolean"
                    }
                }
            }
        },
        "bugs": {
            "type": "array",
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["title", "steps", "expected", "actual"],
                "properties": {
                    "title": {
                        "type": "string"
                    },
                    "steps": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    },
                    "expected": {
                        "type": "string"
                    },
                    "actual": {
                        "type": "string"
                    }
                }
            }
        },
        "screenshots": {
            "type": "array",
            "items": {
                "type": "string"
            }
        }
    }
}
