{
    "name": "@forge/district-orgs",
    "version": "0.0.0",
    "private": true,
    "description": "List organizations in a Yandex Maps district from its geo URL",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./src/index.ts",
    "exports": {
        ".": {
            "types": "./src/index.ts",
            "default": "./dist/index.js"
        }
    },
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "typecheck": "tsc -p tsconfig.test.json --noEmit",
        "test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test src/*.test.ts",
        "clean": "rm -rf dist"
    },
    "devDependencies": {
        "@types/node": "^25.3.0"
    }
}
