{
    "name": "forge",
    "version": "0.0.0",
    "private": true,
    "description": "TypeScript monorepo",
    "scripts": {
        "dev": "pnpm -r --parallel dev",
        "dev:ncottage-www": "pnpm --filter @forge/ncottage-www dev",
        "build:ncottage-www": "pnpm --filter @forge/ncottage-www build",
        "dev:ncottage-api": "pnpm --filter @forge/ncottage-api dev",
        "build:ncottage-api": "pnpm --filter @forge/ncottage-api build",
        "dev:ncottage-admin": "pnpm --filter @forge/ncottage-admin dev",
        "build:ncottage-admin": "pnpm --filter @forge/ncottage-admin build",
        "storybook:ncottage-www": "pnpm --filter @forge/ncottage-www storybook",
        "build": "pnpm -r build",
        "typecheck": "pnpm -r typecheck",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "clean": "pnpm -r clean && rm -rf node_modules",
        "dev:preview": "npm --prefix apps/preview run dev",
        "build:preview": "npm --prefix apps/preview run build"
    },
    "devDependencies": {
        "@types/node": "^25.3.0",
        "@typescript-eslint/eslint-plugin": "^8.56.0",
        "@typescript-eslint/parser": "^8.56.0",
        "eslint": "^8.57.1",
        "eslint-config-next": "^15.5.19",
        "eslint-config-prettier": "^10.1.8",
        "eslint-import-resolver-typescript": "^4.4.4",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-react": "^7.37.5",
        "prettier": "^3.8.1",
        "typescript": "^5.9.3"
    }
}
