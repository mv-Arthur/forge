{
    "root": true,
    "parser": "@typescript-eslint/parser",
    "parserOptions": {
        "ecmaVersion": 2022,
        "sourceType": "module",
        "project": "./tsconfig.json"
    },
    "plugins": ["@typescript-eslint", "import", "react"],
    "extends": [
        "eslint:recommended",
        "plugin:@typescript-eslint/recommended",
        "plugin:import/recommended",
        "plugin:import/typescript",
        "next/core-web-vitals",
        "prettier"
    ],
    "rules": {
        "@typescript-eslint/consistent-type-imports": "error",
        "@typescript-eslint/no-explicit-any": "error",
        "@typescript-eslint/no-unused-vars": [
            "error",
            {
                "argsIgnorePattern": "^_",
                "varsIgnorePattern": "^_"
            }
        ],
        "no-console": "off",
        "react/function-component-definition": [
            "error",
            {
                "namedComponents": "function-declaration",
                "unnamedComponents": "arrow-function"
            }
        ],
        "no-restricted-syntax": [
            "error",
            {
                "selector": "TSTypeReference[typeName.name='FC']",
                "message": "Don't use FC. Type props directly in the function signature."
            },
            {
                "selector": "TSTypeReference[typeName.name='FunctionComponent']",
                "message": "Don't use FunctionComponent. Type props directly in the function signature."
            },
            {
                "selector": "TSQualifiedName[left.name='React'][right.name='FC']",
                "message": "Don't use React.FC. Type props directly in the function signature."
            },
            {
                "selector": "TSQualifiedName[left.name='React'][right.name='FunctionComponent']",
                "message": "Don't use React.FunctionComponent. Type props directly in the function signature."
            }
        ]
    },
    "settings": {
        "react": {
            "version": "19"
        },
        "next": {
            "rootDir": "apps/ncottage-www/"
        },
        "import/resolver": {
            "typescript": {
                "alwaysTryTypes": true,
                "project": [
                    "tsconfig.json",
                    "apps/*/tsconfig.json",
                    "packages/*/tsconfig.json"
                ]
            }
        }
    },
    "ignorePatterns": ["node_modules/", "dist/", "build/", "*.js", "*.d.ts"]
}
