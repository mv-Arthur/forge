{
    "name": "@forge/district-orgs-web",
    "version": "0.0.0",
    "private": true,
    "description": "Telegram mini app: walk sheets for a Yandex Maps district",
    "type": "module",
    "scripts": {
        "build": "tsc -p tsconfig.json && vite build --config ui/vite.config.ts",
        "dev": "node --experimental-strip-types src/dev.ts",
        "start": "node dist/server.js",
        "typecheck": "tsc -p tsconfig.test.json --noEmit && tsc -p ui/tsconfig.json --noEmit",
        "test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test src/*.test.ts",
        "clean": "rm -rf dist ui/dist"
    },
    "dependencies": {
        "@emotion/react": "^11.14.0",
        "@emotion/styled": "^11.14.1",
        "@forge/district-orgs": "workspace:*",
        "@mui/material": "^9.4.0",
        "react": "^19.2.5",
        "react-dom": "^19.2.5"
    },
    "devDependencies": {
        "@types/node": "^25.3.0",
        "@types/react": "^19.2.14",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^6.1.1",
        "vite": "^8.2.2"
    }
}
