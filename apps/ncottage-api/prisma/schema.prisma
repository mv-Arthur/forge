// ncottage-api data model.
// Lead — заявки с сайта. Project — каталог проектов (CMS). Admin — учётка админки.
// Вложенные поля проекта (specs/floorPlans/packages/options) хранятся как JSON:
// они читаются и редактируются только целиком вместе с проектом. Если позже
// понадобятся кросс-проектные запросы по вложенному — нормализуем в ProjectsService.

generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

enum LeadSource {
    contacts
    callback
    project
    works
}

enum LeadStatus {
    new
    contacted
    archived
}

model Lead {
    id            String     @id @default(cuid())
    source        LeadSource
    phone         String
    name          String?
    comment       String?
    preferredTime String?
    project       String?
    consent       Boolean?
    status        LeadStatus @default(new)
    createdAt     DateTime   @default(now())
    // Доставка во внешние системы (Telegram/email):
    deliveredAt      DateTime?
    deliveryError    String?
    deliveryAttempts Int       @default(0)

    @@index([status, createdAt])
}

model Project {
    id          String   @id @default(cuid())
    slug        String   @unique
    name        String
    technology  String
    area        Int
    floors      Int
    bedrooms    Int
    bathrooms   Int
    price       Int
    image       String
    style       String
    livingType  String
    featured    Boolean  @default(false)
    description String
    pdfUrl      String?
    // features — простой enum-массив, не нормализуем.
    features String[]
    // specs (5 фиксированных полей) — колонки самого Project (D4).
    specsDimensions   String
    specsRoofType     String
    specsFoundation   String
    specsWallMaterial String
    specsBuildTime    String

    images     ProjectImage[]
    floorPlans ProjectFloorPlan[]
    packages   ProjectPackage[]
    options    ProjectOption[]
    relations  ProjectRelation[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([technology])
    @@index([featured])
}

model ProjectImage {
    id        String  @id @default(cuid())
    projectId String
    url       String
    mediaId   String?
    order     Int
    project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

    @@index([projectId])
}

model ProjectFloorPlan {
    id        String                 @id @default(cuid())
    projectId String
    label     String
    image     String
    mediaId   String?
    area      Int?
    order     Int
    project   Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
    rooms     ProjectFloorPlanRoom[]

    @@index([projectId])
}

model ProjectFloorPlanRoom {
    id          String           @id @default(cuid())
    floorPlanId String
    name        String
    area        Int
    order       Int
    floorPlan   ProjectFloorPlan @relation(fields: [floorPlanId], references: [id], onDelete: Cascade)

    @@index([floorPlanId])
}

model ProjectPackage {
    id          String                  @id @default(cuid())
    projectId   String
    name        String
    price       Int
    tagline     String?
    highlighted Boolean                 @default(false)
    order       Int
    project     Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
    includes    ProjectPackageInclude[]

    @@index([projectId])
}

model ProjectPackageInclude {
    id        String         @id @default(cuid())
    packageId String
    label     String
    value     String
    order     Int
    package   ProjectPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)

    @@index([packageId])
}

model ProjectOption {
    id        String  @id @default(cuid())
    projectId String
    label     String
    price     Int
    note      String?
    order     Int
    project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

    @@index([projectId])
}

model ProjectRelation {
    id          String  @id @default(cuid())
    projectId   String
    relatedSlug String
    order       Int
    project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

    @@unique([projectId, relatedSlug])
    @@index([projectId])
}

enum Role {
    admin
    editor
}

// Контент-настройки сайта (singletons): nav, footer, contacts. value — типизированный JSON.
model Setting {
    key       String   @id
    value     Json
    updatedAt DateTime @updatedAt
}

model Admin {
    id           String   @id @default(cuid())
    email        String   @unique
    name         String?
    passwordHash String
    role         Role     @default(editor)
    createdAt    DateTime @default(now())
}

model Media {
    id        String   @id @default(cuid())
    key       String   @unique
    url       String
    filename  String
    mime      String
    size      Int
    width     Int?
    height    Int?
    alt       String?
    folder    String?
    createdAt DateTime @default(now())

    @@index([folder])
    @@index([createdAt])
}
