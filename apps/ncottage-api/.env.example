# Сервис
PORT=3002
NODE_ENV=development

# PostgreSQL (совпадает с docker-compose.yml)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ncottage

# CORS: origin админки (через запятую можно несколько). Пусто — CORS выключен.
CORS_ORIGIN=http://localhost:3003

# Auth
JWT_SECRET=change-me
JWT_EXPIRES_IN=12h

# Сид администратора (читается только seed-скриптом)
ADMIN_EMAIL=admin@ncottage.local
ADMIN_PASSWORD=change-me

# S3-совместимое хранилище медиа (локально — MinIO из docker-compose).
# В проде — Yandex Object Storage / S3: задать endpoint, bucket и ключи.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=ncottage-media
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_PUBLIC_URL=http://localhost:9000
S3_FORCE_PATH_STYLE=true
