{
    "name": "@forge/district-orgs-cli",
    "version": "0.0.0",
    "private": true,
    "description": "CLI: Yandex Maps district URL → list of organizations",
    "type": "module",
    "bin": {
        "district-orgs": "./dist/index.js"
    },
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "dev": "node --experimental-strip-types src/index.ts",
        "start": "node dist/index.js",
        "typecheck": "tsc -p tsconfig.test.json --noEmit",
        "test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test src/*.test.ts",
        "clean": "rm -rf dist"
    },
    "dependencies": {
        "@forge/district-orgs": "workspace:*"
    },
    "devDependencies": {
        "@types/node": "^25.3.0"
    }
}
