generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model User {
    id               String               @id @default(cuid())
    email            String               @unique
    name             String?
    passwordHash     String
    emailVerifiedAt  DateTime?
    createdAt        DateTime             @default(now())
    verifications    EmailVerification[]
}

model EmailVerification {
    id        String   @id @default(cuid())
    userId    String
    user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
    tokenHash String   @unique
    expiresAt DateTime
    createdAt DateTime @default(now())

    @@index([userId])
}

model Media {
    id        String   @id @default(cuid())
    key       String   @unique
    url       String
    filename  String
    mime      String
    size      Int
    width     Int?
    height    Int?
    alt       String?
    folder    String?
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    pageSlots PageSlot[]

    @@index([folder])
    @@index([createdAt])
}

model PageSlot {
    page    String
    slot    String
    mediaId String?
    media   Media?  @relation(fields: [mediaId], references: [id], onDelete: SetNull)

    @@id([page, slot])
    @@index([mediaId])
}
